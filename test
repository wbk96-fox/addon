{
  "id": "ekino",
  "name": "Ekino-tv.pl",
  "version": "1.0.0",
  "description": "Scraper JSON do ekino-tv.pl. Wyszukiwanie path-based (/search/{title}), embedy z onclick ShowPlayer('host','id') mapowane na /watch/{host}/{id}. Serial: transformacja /show/X -> /watch/X+season[N]+episode[M]+ (obsluga po stronie runtime).",
  "baseUrl": "https://ekino-tv.pl",
  "language": "pl",
  "types": ["movies", "series"],
  "nsfw": false,
  "priority": 11,
  "enabledByDefault": true,
  "cf": false,
  "category": "portal",
  "moduleType": "scraper",
  "runtime": {
    "enabled": true
  },
  "search": {
    "url": "/search/{title}",
    "method": "GET",
    "headers": {
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
      "Accept-Language": "pl,en-US;q=0.9,en;q=0.8",
      "Referer": "{baseUrl}/",
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/147.0.0.0 Safari/537.36"
    },
    "responseType": "html",
    "resultSelector": {
      "container": ".movie-wrap .movies-list-item:has(.title > a[href])",
      "fields": {
        "title": ".title > a | text",
        "titleEn": ".title .blue a | text",
        "url": ".title > a | href",
        "year": "| regex: (19\\d{2}|20\\d{2})",
        "thumbnail": ".cover-list img | attr:src",
        "description": ".movieDesc | text",
        "rating": ".sum-vote div | text"
      }
    }
  },
  "matching": {
    "titleField": "title",
    "yearField": "year",
    "urlField": "url",
    "yearTolerance": 1,
    "scoring": {
      "minScore": 60
    }
  },
  "detail": {
    "url": "{result.url}",
    "headers": {
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
      "Accept-Language": "pl,en-US;q=0.9,en;q=0.8",
      "Referer": "{baseUrl}/search/{title}",
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/147.0.0.0 Safari/537.36"
    },
    "fields": {
      "title": "h1.title | text",
      "description": ".descriptionMovie | text",
      "poster": "img.moviePoster | attr:src",
      "rating": ".score #scoreSum span[itemprop=ratingValue] | text",
      "year": ".catBox .cat a | regex: (19\\d{2}|20\\d{2})",
      "actors": "div.movieActors ul.actors li a | text",
      "similar": ".relatedmovie > a img.related | attr:src"
    }
  },
  "episode": {
    "url": "{result.url}",
    "container": "ul.list-series li a[href]",
    "urlField": "| href",
    "labelField": "| text",
    "pattern": "episode\\[(\\d+)\\]",
    "tvShowUrlTransform": {
      "search": "/show/",
      "replace": "/watch/",
      "suffix": "+season[{season}]+episode[{episode}]+"
    }
  },
  "sources": {
    "extract": [
      {
        "type": "regex",
        "pattern": "ShowPlayer\\(\\s*'([^']+)'\\s*,\\s*'([^']+)'\\s*\\)",
        "fields": {
          "host": 1,
          "id": 2
        }
      }
    ],
    "output": {
      "url": "{baseUrl}/watch/{host}/{id}",
      "hosting": "{host}",
      "version": "Ekino",
      "quality": "HD",
      "type": "pl",
      "language": "pl",
      "direct": false,
      "canPlay": false,
      "sourceWebsite": "ekino-tv.pl",
      "headers": {
        "Referer": "{result.url}",
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/147.0.0.0 Safari/537.36"
      }
    }
  },
  "errorDetection": [
    {
      "id": "cloudflare",
      "detectIn": "body",
      "contains": "challenges.cloudflare.com",
      "response": {
        "error": "CLOUDFLARE_CHALLENGE",
        "message": "Ekino wymaga przejscia Cloudflare.",
        "requiresWebView": true,
        "url": "{baseUrl}"
      }
    },
    {
      "id": "not_found",
      "detectIn": "body",
      "contains": "404 Not Found",
      "response": {
        "error": "NOT_FOUND",
        "message": "Nie znaleziono materialu na Ekino."
      }
    }
  ]
}